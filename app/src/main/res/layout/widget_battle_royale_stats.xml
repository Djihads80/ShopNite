<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#6750A4">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Battle Royale"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_player_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#EDE6F8"
            android:textSize="12sp" />
    </LinearLayout>

    <GridLayout
        android:id="@+id/widget_stats_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:columnCount="3"
        android:rowCount="2"
        android:useDefaultMargins="true">

        <LinearLayout
            android:id="@+id/widget_stat_card_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="#E8DEF8">
            <TextView
                android:id="@+id/widget_stat_1_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#49454F"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/widget_stat_1_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1D1B20"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_stat_card_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="#E8DEF8">
            <TextView
                android:id="@+id/widget_stat_2_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#49454F"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/widget_stat_2_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1D1B20"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_stat_card_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="#E8DEF8">
            <TextView
                android:id="@+id/widget_stat_3_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#49454F"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/widget_stat_3_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1D1B20"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_stat_card_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="#E8DEF8">
            <TextView
                android:id="@+id/widget_stat_4_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#49454F"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/widget_stat_4_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1D1B20"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_stat_card_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="#E8DEF8">
            <TextView
                android:id="@+id/widget_stat_5_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#49454F"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/widget_stat_5_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1D1B20"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_stat_card_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="#E8DEF8">
            <TextView
                android:id="@+id/widget_stat_6_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#49454F"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/widget_stat_6_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1D1B20"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </GridLayout>
</LinearLayout>

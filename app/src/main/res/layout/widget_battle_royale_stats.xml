<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="@drawable/widget_header_bg">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Battle Royale"
            android:textColor="@color/widget_header_on"
            android:textStyle="bold"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_player_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/widget_header_on"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/widget_header_on_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <GridLayout
        android:id="@+id/widget_stats_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:columnCount="3"
        android:rowCount="3"
        android:useDefaultMargins="true">

        <LinearLayout
            android:id="@+id/widget_stat_card_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="#E8DEF8">
            <TextView
                android:id="@+id/widget_stat_1_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#49454F"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/widget_stat_1_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1D1B20"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_stat_card_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="#E8DEF8">
            <TextView
                android:id="@+id/widget_stat_2_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#49454F"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/widget_stat_2_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1D1B20"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_stat_card_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="#E8DEF8">
            <TextView
                android:id="@+id/widget_stat_3_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#49454F"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/widget_stat_3_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1D1B20"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_stat_card_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="#E8DEF8">
            <TextView
                android:id="@+id/widget_stat_4_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#49454F"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/widget_stat_4_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1D1B20"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_stat_card_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="#E8DEF8">
            <TextView
                android:id="@+id/widget_stat_5_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#49454F"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/widget_stat_5_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1D1B20"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_stat_card_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@drawable/widget_stat_card_bg">
            <TextView
                android:id="@+id/widget_stat_6_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_stat_label"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/widget_stat_6_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_stat_value"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_stat_card_7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@drawable/widget_stat_card_bg">
            <TextView
                android:id="@+id/widget_stat_7_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_stat_label"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/widget_stat_7_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_stat_value"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_stat_card_8"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@drawable/widget_stat_card_bg">
            <TextView
                android:id="@+id/widget_stat_8_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_stat_label"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/widget_stat_8_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_stat_value"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_stat_card_9"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@drawable/widget_stat_card_bg">
            <TextView
                android:id="@+id/widget_stat_9_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_stat_label"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/widget_stat_9_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_stat_value"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </GridLayout>
</LinearLayout>

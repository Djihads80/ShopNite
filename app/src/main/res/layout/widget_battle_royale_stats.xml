<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Battle Royale"
        android:textColor="#E6ECF5"
        android:textStyle="bold"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/widget_player_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_title"
        android:layout_marginTop="4dp"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_player_name"
        android:layout_marginTop="4dp"
        android:textColor="#C7D2E3"
        android:textSize="12sp" />

    <GridLayout
        android:id="@+id/widget_stats_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_subtitle"
        android:layout_marginTop="12dp"
        android:columnCount="3"
        android:rowCount="2"
        android:useDefaultMargins="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="4dp">
            <TextView
                android:id="@+id/widget_stat_1_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#AEB9CB"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/widget_stat_1_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="4dp">
            <TextView
                android:id="@+id/widget_stat_2_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#AEB9CB"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/widget_stat_2_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="4dp">
            <TextView
                android:id="@+id/widget_stat_3_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#AEB9CB"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/widget_stat_3_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="4dp">
            <TextView
                android:id="@+id/widget_stat_4_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#AEB9CB"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/widget_stat_4_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="4dp">
            <TextView
                android:id="@+id/widget_stat_5_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#AEB9CB"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/widget_stat_5_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:padding="4dp">
            <TextView
                android:id="@+id/widget_stat_6_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#AEB9CB"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/widget_stat_6_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </GridLayout>
</RelativeLayout>
